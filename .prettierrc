{
  "singleQuote": true,
  "semi": false,
  "printWidth": 100,
  "trailingComma": "es5",
  "vueIndentScriptAndStyle": true,
  "overrides": [
    { "files": ["*.vue"], "options": { "parser": "vue" } },
    { "files": ["*.ts"], "options": { "parser": "typescript" } },
    { "files": ["*.js"], "options": { "parser": "babel" } }
  ]
}
